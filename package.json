{
  "name": "sumunjang",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "e2e": "playwright test",
    "bots": "vite-node src/bots/run.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run e2e && npm run bots",
    "build:pages": "tsc --noEmit && vite build --outDir docs --emptyOutDir && touch docs/.nojekyll"
  },
  "dependencies": {
    "idb": "^8.0.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "eslint": "^10.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.5"
  }
}
